{"type": "FeatureCollection", "features": [{"type": "Feature", "id": "historic/afton-museum", "properties": {"id": "afton-museum", "order": 1, "name": "Congregational Church / Memorial Hall / Afton Historical Museum", "address": "3165 St Croix Trl S", "lat": 44.9024991, "lon": -92.7827905, "designation": "City of Afton designated historic site", "description": "Built in 1868 by the Congregational Church Society, the building was moved to its present location in 1926 after a mudslide. It later became a community meeting hall and the home of the Afton Historical Museum.", "sourceUrl": "https://historicplace.org/afton/congregational-church-memorial-hall-afton-historical-museum/", "mapUrl": "https://www.google.com/maps/place/Afton+Historical+Museum/@44.9024991,-92.7827905,17z/", "osm_building_feature": "way/1307292060", "era": 1855, "parcel_pin": "2202820110004", "parcel_plat": "AFTON", "samplePhoto": "images/afton-museum-sample.jpg", "samplePhotoAlt": "Exterior of the Afton Historical Museum, the former Congregational Church, viewed from the west", "samplePhotoCredit": "McGhiever, CC BY-SA 4.0, via Wikimedia Commons", "samplePhotoCreditUrl": "https://commons.wikimedia.org/wiki/File:Afton_Historical_Museum.jpg", "sampleAudio": "audio/afton-museum-sample.wav", "sampleTranscript": "Sample narration. The Afton Historical Museum occupies the 1868 Congregational Church, moved to this site in 1926 after a mudslide. It later served as Memorial Hall. This short clip shows where finished audio will play."}, "geometry": {"type": "Polygon", "coordinates": [[[1734.4664409782854, 1043.669667975977], [1730.5268613690278, 1043.6702375402674], [1730.5235631305259, 1044.9032857427374], [1719.3601023618248, 1044.9067605696619], [1719.3647528067813, 1052.0273995893076], [1721.3621869486524, 1052.0216306801885], [1721.3619742558803, 1055.0542838983238], [1739.9940588199534, 1055.0374711053446], [1739.981817381049, 1044.8619405543432], [1734.4711260327604, 1044.8694116733968], [1734.4664409